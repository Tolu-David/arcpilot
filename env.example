# ArcPilot — environment variable reference
# Copy to .env and fill in real values. Never commit .env.
# All values marked [REQUIRED] must be set before the relevant feature works.
# All values marked [OPTIONAL] have safe defaults shown.

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (Vite) — prefix VITE_ exposes the value to the browser bundle.
# Never put secrets or private keys under a VITE_ prefix.
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] WalletConnect Project ID — get one at https://cloud.walletconnect.com
# Required for the QR-code wallet connection flow. ConnectKit works without it
# for injected wallets (MetaMask) but will show a warning.
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# [REQUIRED after deploy] Deployed ArcPilot contract address on Arc Testnet.
# Set this after running the deploy step. The UI falls back to the hardcoded
# milestone-1 address when this is unset.
VITE_ARCPILOT_CONTRACT=0xYourDeployedContractAddressHere

# ─────────────────────────────────────────────────────────────────────────────
# SERVER — never prefix with VITE_. These are server-only secrets.
# ─────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Port the Express API server listens on. Default: 3001.
AGENT_SERVER_PORT=3001

# [REQUIRED for paid endpoints] EVM address that receives USDC Gateway payments.
# Use your connected wallet address, a developer-controlled wallet address,
# or the ArcPilot contract address. Never a private key or seed phrase.
SELLER_ADDRESS=0xYourSellerAddressHere

# [OPTIONAL] Payment adapter mode.
#   sim      — local simulation, no blockchain (default when unset)
#   testnet  — Arc Testnet via Circle Gateway (requires SELLER_ADDRESS)
#   mainnet  — Arc Mainnet (also requires MAINNET_CONFIRMED=true)
PAYMENT_ADAPTER=sim

# [REQUIRED for PAYMENT_ADAPTER=mainnet] Explicit mainnet opt-in guard.
# Set to exactly "true" only after completing an independent security review.
# MAINNET_CONFIRMED=true

# [OPTIONAL] Circle Gateway facilitator URLs. Defaults shown.
# GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# GATEWAY_FACILITATOR_URL_MAINNET=https://gateway-api.circle.com

# [OPTIONAL] Simulation payer address shown in sim-mode receipts.
# SIM_PAYER_ADDRESS=0xSimulatedPayerAddress

# ─────────────────────────────────────────────────────────────────────────────
# CIRCLE DEVELOPER PLATFORM (optional — required only for developer-controlled
# wallets or direct Smart Contract Platform API calls)
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED for write endpoints] Secret token for payment status and reconciliation endpoints.
# Set to a strong random value: openssl rand -hex 32
# Must be set when NODE_ENV=production — server refuses to start without it.
# Write endpoints accept X-ArcPilot-Token header; only this value is valid.
ARCPILOT_WRITE_TOKEN=your_strong_random_write_token_here

# [OPTIONAL] CORS allowed origin for the Express API server.
# Default: http://localhost:5173 (Vite dev proxy).
# Set to your deployed frontend URL in production. Use * only behind a gateway.
ALLOWED_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# AI STUDIO
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED for AI recommendations] Google AI Studio API key.
# Get one at https://aistudio.google.com/app/apikey
AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
AI_STUDIO_project_name=your_project_name_here
AI_studio_name=your_studio_name_here

# [OPTIONAL] Override the Gemini model. Default: gemini-2.0-flash
# AI_STUDIO_MODEL=gemini-2.0-flash-lite

# [OPTIONAL] Enable verbose AI debug logging (never logs API keys).
# AI_DEBUG_LOG=true

# ─────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Circle Standard Developer API Key.
# Required for developer-controlled wallets and SCP APIs.
# Create via Arc Studio consent flow or https://console.circle.com
# CIRCLE_API_KEY=your_circle_api_key_here

# [OPTIONAL] Circle entity secret for developer-controlled wallets.
# One-time registration — see register-entity-secret skill.
# CIRCLE_ENTITY_SECRET=your_32_byte_hex_entity_secret_here


