# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.

# ── Frontend (VITE_ prefix = exposed to the browser bundle) ─────────────────

# WalletConnect Project ID — get one free at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# Deployed ArcPilot contract address on Arc Testnet (set after deploy)
VITE_ARCPILOT_CONTRACT=

# ── Server-only secrets (no VITE_ prefix — never sent to the browser) ────────

# Circle Standard Developer API Key — provisioned via Arc Studio consent flow
CIRCLE_API_KEY=

# Circle Entity Secret — registered once, non-idempotent — back up immediately
CIRCLE_ENTITY_SECRET=

# ── Agent payment server ──────────────────────────────────────────────────────

# EVM address that receives USDC Gateway Nanopayments (seller side)
# Required to start the agent server (bun run server)
SELLER_ADDRESS=

# Override port for the Express agent server (default: 3001)
# AGENT_SERVER_PORT=3001

# Circle Gateway facilitator URL (default: testnet)
# GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
