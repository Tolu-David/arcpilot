{
  "name": "arcpilot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "server": "bun --watch server/start.ts",
    "build": "tsc --project tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit --project tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.server.json",
    "check": "tsc --noEmit && tsc --noEmit --project tsconfig.server.json",
    "test:contracts": "forge test --root . -vv",
    "test:policy": "tsx --test server/policy.test.ts",
    "test:spending-policy": "tsx --test server/spending-policy.test.ts",
    "test:ai-recommend": "tsx --test server/ai-recommend.test.ts",
    "test:payment-prepare": "tsx --test server/payment-prepare.test.ts",
    "test:reconciler": "tsx --test server/reconciler.test.ts",
    "test:ui": "vitest run",
    "test:audit-fixes": "tsx --test server/audit-fixes.test.ts",
    "test:ui:watch": "vitest",
    "test:e2e": "bun run contracts/test-integration/e2e-scenarios.ts"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.5.0",
    "@google/genai": "^2.31.0",
    "@openzeppelin/contracts": "5.1.0",
    "@tanstack/react-query": "^5.0.0",
    "@web3icons/react": "^3.0.0",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "clsx": "^2.1.0",
    "connectkit": "^1.8.2",
    "express": "^5.3.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "viem": "^2.21.56",
    "wagmi": "^2.13.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vitest": "^5.0.5"
  }
}
